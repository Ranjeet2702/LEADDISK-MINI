# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/leaddesk?retryWrites=true&w=majority

# Port the API listens on
PORT=5000

# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_string

# How long an admin login session stays valid
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call this API (your deployed frontend URL)
CORS_ORIGIN=http://localhost:5173

# Admin login credentials (used only by scripts/seedAdmin.js to create the one admin user)
SEED_ADMIN_EMAIL=admin@leaddesk.test
SEED_ADMIN_PASSWORD=ChangeMe123!
