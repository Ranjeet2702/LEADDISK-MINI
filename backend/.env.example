# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGO_URI=mongodb+srv://ranjprijeet2702_db_user:Ranjeet123@cluster0.eckdng8.mongodb.net/?appName=Cluster0

# Port the API listens on
